# systemd service for Upwork Job Alert Lite (see DEPLOY.md).
# Install: sudo cp deploy/upwork-job-alert.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now upwork-job-alert
[Unit]
Description=Upwork Job Alert Lite (searches every ~30 min + local dashboard)
Wants=network-online.target
After=network-online.target
# Never stop retrying after repeated crashes.
StartLimitIntervalSec=0

[Service]
Type=simple
User=upworkbot
Group=upworkbot
WorkingDirectory=/opt/upwork-bot
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts watch
# Restart after a crash, a server reboot or an update, without giving up.
Restart=always
RestartSec=10
Environment=NODE_ENV=production

# Hardening: the bot only needs to write inside its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/upwork-bot

[Install]
WantedBy=multi-user.target
