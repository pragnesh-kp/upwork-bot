# Upwork Job Alert Lite - configuration. Copy to .env and fill in. Never commit .env.

# --- Telegram (create a bot with @BotFather) -------------------------------------
TELEGRAM_BOT_TOKEN=
# Your chat id (send /start to @userinfobot) or a group id like -1001234567890; comma-separate several.
TELEGRAM_CHAT_ID=
# true = write messages to data/telegram-dry-run.log instead of sending (default true when no token is set)
TELEGRAM_DRY_RUN=

# --- Upwork MCP (official, OAuth; you sign in yourself) ----------------------------
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
# REQUIRED for SOURCE=upwork-mcp: encrypts your OAuth tokens on disk. 32 random bytes, base64. Generate in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# or with Node:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Local port for the OAuth redirect (http://127.0.0.1:<port>/callback).
OAUTH_CALLBACK_PORT=53682
# Only if Upwork rejects dynamic client registration: an https URL where you host a client metadata document.
MCP_CLIENT_METADATA_URL=
# If your Upwork login has several freelancer/agency accounts, the exact account name to use.
UPWORK_ACCOUNT_NAME=

# --- Search behaviour (keep it modest: Upwork meters marketplace searches tightly) --
# npm run watch / background task: minutes between automatic searches (10-1440).
SEARCH_INTERVAL_MINUTES=30
# Local dashboard port (http://127.0.0.1:<port>/).
DASHBOARD_PORT=5174
# Pages (10 jobs each) per search on a normal run; paging stops early once a page has nothing new.
MAX_PAGES_PER_FILTER=3
# Pages per search the first time a filter runs (after adding it or a reset).
FIRST_RUN_MAX_PAGES=10
PAGE_SIZE=10
DELAY_BETWEEN_SEARCHES_MS=5000
# false = the first run of each filter records existing jobs silently (no alert flood)
ALERT_ON_FIRST_RUN=false
DESCRIPTION_MAX_CHARS=500
# Days to keep job ids / alert history. Upwork's terms allow at most 30 days for MCP outputs.
RETENTION_DAYS=30

# --- Files ---------------------------------------------------------------------
DATA_DIR=data
FILTERS_FILE=filters.json
LOG_LEVEL=info
