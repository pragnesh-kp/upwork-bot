# Upwork Job Alert Lite - configuration.
# On your PC: copy to .env and fill in. Never commit .env.
# On Vercel: set the same names in Project → Settings → Environment Variables (see DEPLOY.md).

# --- Database (Turso) -------------------------------------------------------------
# Set by Vercel's Turso integration. Leave empty on your PC to use a local file (data/local.db);
# fill them in on your PC to run "npm run connect / discover / import" against the live database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Dashboard login ----------------------------------------------------------------
# Required on Vercel (10+ characters). Optional on your PC.
DASHBOARD_PASSWORD=Yatin@123

# --- Scheduler ------------------------------------------------------------------------
# The external scheduler (cron-job.org) sends "Authorization: Bearer <CRON_SECRET>" to /api/cron.
# 16+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
# Minutes between searches (the scheduler may call more often; extra calls do nothing).
SEARCH_INTERVAL_MINUTES=30

# --- Upwork MCP (official, OAuth; you sign in yourself) ----------------------------
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
# REQUIRED: encrypts your Upwork sign-in before it is stored. 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value on your PC and on Vercel.
TOKEN_ENCRYPTION_KEY=
# Local port for the OAuth redirect during "npm run connect" (http://127.0.0.1:<port>/callback).
OAUTH_CALLBACK_PORT=53682
# Only if Upwork rejects dynamic client registration: an https URL where you host a client metadata document.
MCP_CLIENT_METADATA_URL=
# If your Upwork login has several freelancer/agency accounts, the exact account name to use.
UPWORK_ACCOUNT_NAME=

# --- Search behaviour (keep it modest: Upwork meters marketplace searches tightly) --
# Pages (10 jobs each) per search on a normal run; paging stops early once a page has nothing new.
MAX_PAGES_PER_FILTER=3
# Pages per search the first time a filter runs (after adding it).
FIRST_RUN_MAX_PAGES=10
PAGE_SIZE=10
DELAY_BETWEEN_SEARCHES_MS=3000
# Seconds of search work per scheduler/dashboard call; the rest continues on the next call.
# 20 fits cron-job.org's 30-second limit. Raise only if your scheduler waits longer (Vercel allows 300).
STEP_BUDGET_SECONDS=20
# Days to keep job data. Upwork's terms allow at most 30 days for MCP outputs.
RETENTION_DAYS=30

# --- Local only -------------------------------------------------------------------
DASHBOARD_PORT=5174
DATA_DIR=data
LOG_LEVEL=info
