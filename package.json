{
  "name": "upwork-job-alert-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Upwork job alerts dashboard via the official Upwork MCP server; runs on Vercel + Turso",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/cli.ts dev",
    "build": "node scripts/build-vercel.mjs",
    "connect": "node --disable-warning=ExperimentalWarning src/cli.ts connect",
    "discover": "node --disable-warning=ExperimentalWarning src/cli.ts discover",
    "import": "node --disable-warning=ExperimentalWarning src/cli.ts import",
    "filters": "node --disable-warning=ExperimentalWarning src/cli.ts filters",
    "search": "node --disable-warning=ExperimentalWarning src/cli.ts search",
    "status": "node --disable-warning=ExperimentalWarning src/cli.ts status",
    "purge": "node --disable-warning=ExperimentalWarning src/cli.ts purge",
    "disconnect": "node --disable-warning=ExperimentalWarning src/cli.ts disconnect",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  }
}
